# The DomEase Node.js API. Leave empty to run the admin on demo data
# (src/store/services/mode.js). Example: https://api.domease.app
VITE_API_URL=

# Google AdSense publisher id for the web app's ad slots (ca-pub-…). Leave empty
# for no ads on the web; demo builds then show where an ad would sit.
VITE_ADSENSE_CLIENT=
